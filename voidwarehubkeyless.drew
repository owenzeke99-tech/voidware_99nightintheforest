    TweenService:Create(GetKeyBtn, TweenInfo.new(0.18), {BackgroundColor3 = Color3.fromRGB(42, 42, 54), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
    TweenService:Create(GetKeyStroke, TweenInfo.new(0.18), {Transparency = 0.2}):Play()
end)
GetKeyBtn.MouseLeave:Connect(function()
    TweenService:Create(GetKeyBtn, TweenInfo.new(0.18), {BackgroundColor3 = Color3.fromRGB(30, 30, 38), TextColor3 = Color3.fromRGB(220, 220, 230)}):Play()
    TweenService:Create(GetKeyStroke, TweenInfo.new(0.18), {Transparency = 0.55}):Play()
end)

-- Sự kiện GET KEY (Link mới)
GetKeyBtn.MouseButton1Click:Connect(function()
    local keyLink = "https://link4m.net/yoGYQJBH"
    if syn and syn.write_clipboard then
        syn.write_clipboard(keyLink)
    elseif setclipboard then
        setclipboard(keyLink)
    end
    ShowToast("info", "Key link copied to clipboard!")
end)

-- Hiệu ứng lắc khi sai key
local isShaking = false
local function ShakeMenu()
    if isShaking then return end
    isShaking = true

    local originalPos = MainFrame.Position
    local offsets = {-10, 10, -7, 7, -4, 4, 0}
    local tweenInfo = TweenInfo.new(0.04, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

    for _, offset in ipairs(offsets) do
        local targetPos = UDim2.new(originalPos.X.Scale, originalPos.X.Offset + offset, originalPos.Y.Scale, originalPos.Y.Offset)
        local tween = TweenService:Create(MainFrame, tweenInfo, {Position = targetPos})
        tween:Play()
        tween.Completed:Wait()
    end

    isShaking = false
end

MainFrame.Size = UDim2.new(0, 340, 0, 200)
MainFrame.Position = UDim2.new(0.5, -170, 0.5, -100)
TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
    Size = UDim2.new(0, 380, 0, 235),
    Position = UDim2.new(0.5, -190, 0.5, -117)
}):Play()

-- Sự kiện CHECK KEY
CheckBtn.MouseButton1Click:Connect(function()
    if KeyBox.Text == CorrectKey then
        -- Lưu cache 24h nếu executor hỗ trợ writefile
        if writefile then
            local cacheData = game:GetService("HttpService"):JSONEncode({
                Key = CorrectKey,
                Time = os.time()
            })
            pcall(function()
                writefile(FileName, cacheData)
            end)
        end

        ShowToast("success", "Key verified! Launching Voidware Hub...")

        task.wait(0.85)
        local closeTween = TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0)
        })
        closeTween:Play()
        closeTween.Completed:Wait()
        ScreenGui:Destroy()

        LaunchHub()
    else
        ShowToast("error", "Invalid key! Please check and try again.")
        KeyBox.Text = ""
        task.spawn(ShakeMenu)
    end
end)
