ToastText.Font = Enum.Font.GothamMedium
ToastText.Parent = ToastFrame

local toastToken = 0
local function ShowToast(msgType, message)
    toastToken += 1
    local currentToken = toastToken

    local bgColor, accentColor, textColor, iconSymbol
    if msgType == "error" then
        bgColor = Color3.fromRGB(48, 20, 25)
        accentColor = Color3.fromRGB(255, 75, 85)
        textColor = Color3.fromRGB(255, 200, 205)
        iconSymbol = "✕"
    elseif msgType == "success" then
        bgColor = Color3.fromRGB(18, 45, 30)
        accentColor = Color3.fromRGB(65, 235, 130)
        textColor = Color3.fromRGB(200, 255, 220)
        iconSymbol = "✓"
    else
        bgColor = Color3.fromRGB(20, 36, 52)
        accentColor = Color3.fromRGB(70, 185, 255)
        textColor = Color3.fromRGB(200, 235, 255)
        iconSymbol = "i"
    end

    ToastFrame.BackgroundColor3 = bgColor
    ToastStroke.Color = accentColor
    ToastIcon.BackgroundColor3 = accentColor
    ToastIcon.Text = iconSymbol
    ToastText.TextColor3 = textColor
    ToastText.Text = message

    ToastFrame.Position = UDim2.new(0.08, 0, 0, 190)

    local showInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    TweenService:Create(ToastFrame, showInfo, {Position = UDim2.new(0.08, 0, 0, 182), BackgroundTransparency = 0.15}):Play()
    TweenService:Create(ToastStroke, showInfo, {Transparency = 0.35}):Play()
    TweenService:Create(ToastIcon, showInfo, {BackgroundTransparency = 0.15, TextTransparency = 0}):Play()
    TweenService:Create(ToastText, showInfo, {TextTransparency = 0}):Play()

    if msgType ~= "success" then
        task.delay(3, function()
            if toastToken ~= currentToken then return end
            local hideInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            TweenService:Create(ToastFrame, hideInfo, {Position = UDim2.new(0.08, 0, 0, 188), BackgroundTransparency = 1}):Play()
            TweenService:Create(ToastStroke, hideInfo, {Transparency = 1}):Play()
            TweenService:Create(ToastIcon, hideInfo, {BackgroundTransparency = 1, TextTransparency = 1}):Play()
            TweenService:Create(ToastText, hideInfo, {TextTransparency = 1}):Play()
        end)
    end
end

-- Kéo thả UI
local dragging, dragInput, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)
MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

